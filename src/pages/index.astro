---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleList from '../components/ArticleList.astro';
import ContentImage from '../components/ContentImage.astro';
import EmptyState from '../components/EmptyState.astro';
import EventList from '../components/EventList.astro';
import FeaturedCampaign from '../components/FeaturedCampaign.astro';
import Icon from '../components/Icon.astro';
import IssueList from '../components/IssueList.astro';
import NewsletterForm from '../components/forms/NewsletterForm.astro';
import { home } from '../config/home';
import { site } from '../config/site';
import { getFeaturedCampaign } from '../lib/campaign';
import { getPublished, sortArticles, sortIssues, splitEvents } from '../lib/content';
import { withBase } from '../lib/urls';

const campaign = await getFeaturedCampaign();
const issues = sortIssues(await getPublished('issues'))
  .filter((i) => i.data.state !== 'archived')
  .slice(0, 4);
const { upcoming } = splitEvents(await getPublished('events'));
const events = upcoming.slice(0, 3);
const articles = sortArticles(await getPublished('articles')).slice(0, 3);
const { hero, intro, ways, closing } = home;

const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  url: `${site.url}/`,
  publisher: { '@id': `${site.url}/#organization` },
};
---

<BaseLayout title={home.seo.title} description={home.seo.description} jsonLd={[website]}>
  <!-- Hero ---------------------------------------------------------------->
  <section class="hero" aria-labelledby="hero-title">
    <div class="container">
      <h1 id="hero-title" class="hero__title">
        {
          hero.headline.map((line) => (
            <>
              <span class="hero__line">{line}</span>{' '}
            </>
          ))
        }
      </h1>
      <div class="hero__row">
        <p class="lead hero__lead">{hero.lead}</p>
        <div class="btn-row hero__actions">
          <a class="btn btn--action btn--lg" href={withBase(hero.primary.href)}>
            {hero.primary.label}
            <Icon name="arrow-right" />
          </a>
          <a class="btn btn--outline btn--lg" href={withBase(hero.secondary.href)}>{hero.secondary.label}</a>
        </div>
      </div>
    </div>
    {
      hero.image && (
        <figure class="container hero__photo">
          <div class="frame hero__frame">
            <ContentImage src={hero.image.src} alt={hero.image.alt} position={hero.image.position} sizes="(min-width: 77rem) 77rem, 100vw" priority />
          </div>
          {(hero.image.caption || hero.image.credit) && (
            <figcaption>
              {hero.image.caption}
              {hero.image.credit && <span> Photo: {hero.image.credit}</span>}
            </figcaption>
          )}
        </figure>
      )
    }
  </section>

  <!-- Introduction --------------------------------------------------------->
  <section class="section intro" aria-labelledby="intro-title">
    <div class="container intro__grid">
      <h2 id="intro-title" class="intro__heading">{intro.heading}</h2>
      <div class="intro__body">
        {intro.paragraphs.map((p, i) => <p class:list={{ lead: i === 0 }}>{p}</p>)}
        <dl class="intro__points">
          {
            intro.points.map((point) => (
              <div class="intro__point">
                <dt>{point.title}</dt>
                <dd>{point.text}</dd>
              </div>
            ))
          }
        </dl>
        <a class="link-arrow" href={withBase(intro.link.href)}>
          {intro.link.label}
          <Icon name="arrow-right" />
        </a>
      </div>
    </div>
  </section>

  <!-- Featured campaign ---------------------------------------------------->
  {campaign && <FeaturedCampaign campaign={campaign} />}

  <!-- Local issues (only when real issues are published) ------------------->
  {
    issues.length > 0 && (
      <section class="section" aria-labelledby="issues-title">
        <div class="container">
          <div class="section-head">
            <div>
              <h2 id="issues-title">Local issues</h2>
              <p>What we’re following in Van, and where each one stands.</p>
            </div>
            <a class="link-arrow" href={withBase('/issues/')}>
              All issues
              <Icon name="arrow-right" />
            </a>
          </div>
          <IssueList issues={issues} featureFirst />
        </div>
      </section>
    )
  }

  <!-- Ways to participate -------------------------------------------------->
  <section class="section section--alt ways" aria-labelledby="ways-title">
    <div class="container ways__grid">
      <div class="ways__intro">
        <h2 id="ways-title">{ways.heading}</h2>
        <p class="lead">{ways.lead}</p>
      </div>
      <ul class="ways__list" role="list">
        {
          ways.items.map((item) => (
            <li class="ways__item">
              <h3 class="ways__title">
                <a href={withBase(item.href)} class="ways__link">
                  {item.title}
                </a>
              </h3>
              <p class="ways__text">{item.text}</p>
              <span class="ways__cta" aria-hidden="true">
                {item.cta}
                <Icon name="arrow-right" />
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Calendar and latest articles ----------------------------------------->
  <section class="section updates" aria-label="Upcoming events and latest updates">
    <div class="container updates__grid">
      <div class="updates__col">
        <div class="section-head">
          <h2>On the calendar</h2>
          <a class="link-arrow" href={withBase('/events/')}>
            All events
            <Icon name="arrow-right" />
          </a>
        </div>
        {
          events.length > 0 ? (
            <EventList events={events} compact upcoming />
          ) : (
            <EmptyState
              compact
              title="No events scheduled yet"
              text="When a community event or meeting is confirmed, it will be listed here with the date, time and place. Local government meetings are posted on the city’s and school district’s own websites."
              action={{ label: 'Get notified by email', href: '/newsletter/' }}
              secondary={{ label: 'Find public meetings', href: '/resources/' }}
            />
          )
        }
      </div>
      <div class="updates__col">
        <div class="section-head">
          <h2>Latest updates</h2>
          <a class="link-arrow" href={withBase('/news/')}>
            All news
            <Icon name="arrow-right" />
          </a>
        </div>
        {
          articles.length > 0 ? (
            <ArticleList articles={articles} variant="compact" />
          ) : (
            <EmptyState
              compact
              title="Our first article is on the way"
              text="We publish explainers and updates only when there is something real to report. The first one will introduce our first community initiative."
              action={campaign ? { label: 'Preview the first initiative', href: campaign.articleHref } : { label: 'Get updates by email', href: '/newsletter/' }}
            />
          )
        }
      </div>
    </div>
  </section>

  <!-- Newsletter ----------------------------------------------------------->
  <section class="section inverse newsletter-band" aria-labelledby="newsletter-title">
    <div class="container newsletter-band__grid">
      <div class="newsletter-band__text">
        <h2 id="newsletter-title">Know what’s happening in Van</h2>
        <p>
          Occasional emails when there’s a new issue to understand, a meeting worth attending, or a way to help. No spam, and you can unsubscribe at
          any time.
        </p>
      </div>
      <NewsletterForm id="home-newsletter" source="homepage" variant="inline" submitClass="btn--light" />
    </div>
  </section>

  <!-- Closing call to action ------------------------------------------------->
  <section class="section closing" aria-labelledby="closing-title">
    <div class="container closing__grid">
      <h2 id="closing-title" class="closing__title">{closing.heading}</h2>
      <div class="closing__body">
        <p class="lead">{closing.text}</p>
        <a class="btn btn--primary btn--lg" href={withBase(closing.cta.href)}>
          {closing.cta.label}
          <Icon name="arrow-right" />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero ------------------------------------------------------------------ */
  .hero {
    padding-block: clamp(3rem, 1.75rem + 5vw, 6.5rem) clamp(3rem, 2rem + 4vw, 5.5rem);
  }

  .hero__title {
    font-size: clamp(2.3rem, 1.2rem + 4.2vw, 4.4rem);
    font-weight: var(--weight-display);
    line-height: var(--lh-display);
    letter-spacing: -0.028em;
    color: var(--gv-deep-blue);
  }

  .hero__line {
    display: block;
  }

  .hero__row {
    display: grid;
    gap: var(--space-xl);
    margin-top: clamp(2rem, 1.5rem + 2vw, 3rem);
    padding-top: var(--space-l);
    border-top: var(--rule-thick) solid var(--gv-ink);
  }

  .hero__lead {
    max-width: 40ch;
    margin: 0;
    color: var(--gv-slate-800);
  }

  .hero__photo {
    margin-top: clamp(2.5rem, 2rem + 2vw, 3.5rem);
    margin-bottom: 0;
  }

  .hero__frame {
    aspect-ratio: 21 / 9;
  }

  .hero__frame :global(picture),
  .hero__frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__photo figcaption {
    margin-top: var(--space-s);
    font-size: var(--fs-small);
    color: var(--color-text-muted);
  }

  @media (max-width: 29.99em) {
    .hero__actions .btn {
      width: 100%;
    }
  }

  @media (min-width: 62em) {
    .hero__row {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      gap: var(--space-3xl);
    }
  }

  /* Introduction ------------------------------------------------------------ */
  .intro {
    border-top: 1px solid var(--color-border);
  }

  .intro__grid {
    display: grid;
    gap: var(--space-xl);
  }

  .intro__heading {
    font-size: var(--fs-h2);
    max-width: 18ch;
  }

  .intro__body {
    max-width: 44rem;
  }

  .intro__body > p:not(.lead) {
    color: var(--color-text-muted);
  }

  .intro__points {
    margin: var(--space-xl) 0;
    border-top: var(--rule-thick) solid var(--gv-ink);
  }

  .intro__point {
    display: grid;
    gap: 0.2rem var(--space-l);
    padding-block: var(--space-m);
    border-bottom: 1px solid var(--color-border);
  }

  .intro__point dt {
    font-size: 1.25rem;
    font-weight: var(--weight-display);
    color: var(--gv-deep-blue);
  }

  .intro__point dd {
    margin: 0;
  }

  @media (min-width: 40em) {
    .intro__point {
      grid-template-columns: 7rem 1fr;
      align-items: baseline;
    }
  }

  @media (min-width: 62em) {
    .intro__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: clamp(2rem, 5vw, 5rem);
      align-items: start;
    }

    .intro__heading {
      position: sticky;
      top: calc(var(--header-h) + 2rem);
    }
  }

  /* Ways to participate ----------------------------------------------------- */
  .ways__grid {
    display: grid;
    gap: var(--space-xl);
  }

  .ways__intro h2 {
    max-width: 14ch;
  }

  .ways__intro .lead {
    margin-top: var(--space-m);
    max-width: 26ch;
    color: var(--color-text-muted);
  }

  .ways__list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: var(--rule-thick) solid var(--gv-ink);
  }

  .ways__item {
    position: relative;
    display: grid;
    gap: var(--space-xs);
    padding: var(--space-l) var(--space-s);
    border-bottom: 1px solid var(--gv-slate-300);
    transition: background-color var(--dur) var(--ease);
  }

  .ways__item:hover {
    background: var(--gv-white);
  }

  .ways__title {
    font-size: clamp(1.5rem, 1.25rem + 1.1vw, 2.15rem);
    font-weight: var(--weight-display);
  }

  .ways__link {
    color: var(--gv-ink);
    text-decoration: none;
  }

  .ways__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .ways__link:focus-visible {
    outline: none;
  }

  .ways__item:has(.ways__link:focus-visible) {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
    background: var(--gv-white);
  }

  .ways__item:hover .ways__link {
    color: var(--gv-deep-blue);
  }

  .ways__text {
    margin: 0;
    max-width: 52ch;
    color: var(--color-text-muted);
  }

  .ways__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: var(--space-2xs);
    font-size: var(--fs-small);
    font-weight: 700;
    color: var(--gv-deep-blue);
  }

  .ways__cta :global(svg) {
    width: 1em;
    height: 1em;
    transition: transform var(--dur) var(--ease);
  }

  .ways__item:hover .ways__cta {
    color: var(--gv-crimson);
  }

  .ways__item:hover .ways__cta :global(svg) {
    transform: translateX(4px);
  }

  @media (min-width: 48em) {
    .ways__item {
      grid-template-columns: minmax(10rem, 15rem) 1fr auto;
      align-items: baseline;
      gap: var(--space-l);
      padding-inline: var(--space-m);
    }

    .ways__cta {
      margin: 0;
      white-space: nowrap;
    }
  }

  @media (min-width: 62em) {
    .ways__grid {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      gap: clamp(2rem, 5vw, 5rem);
    }
  }

  /* Calendar & updates ----------------------------------------------------- */
  .updates__grid {
    display: grid;
    gap: var(--space-3xl) clamp(2rem, 5vw, 5rem);
  }

  .updates .section-head h2 {
    font-size: clamp(1.6rem, 1.35rem + 1vw, 2.2rem);
  }

  @media (min-width: 62em) {
    .updates__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* Newsletter -------------------------------------------------------------- */
  .newsletter-band__grid {
    display: grid;
    gap: var(--space-xl);
    align-items: start;
  }

  .newsletter-band__text h2 {
    max-width: 16ch;
  }

  .newsletter-band__text p {
    margin-top: var(--space-m);
    max-width: 46ch;
    color: var(--color-text-inverse-muted);
  }

  @media (min-width: 62em) {
    .newsletter-band__grid {
      grid-template-columns: 5fr 6fr;
      gap: clamp(2rem, 6vw, 6rem);
    }
  }

  /* Closing ----------------------------------------------------------------- */
  .closing__grid {
    display: grid;
    gap: var(--space-l) var(--space-3xl);
    padding-top: var(--space-xl);
    border-top: 8px solid var(--gv-crimson);
  }

  .closing__title {
    font-size: var(--fs-display);
    font-weight: var(--weight-display);
    line-height: var(--lh-display);
    color: var(--gv-ink);
  }

  .closing__body .lead {
    max-width: 40ch;
    color: var(--color-text-muted);
  }

  .closing__body .btn {
    margin-top: var(--space-xl);
  }

  @media (min-width: 62em) {
    .closing__grid {
      grid-template-columns: 6fr 5fr;
      align-items: end;
    }
  }
</style>
