---
/**
 * <head> metadata: title, description, canonical URL, Open Graph, Twitter
 * card, robots and JSON-LD structured data. Every URL uses the canonical
 * production origin from src/config/site.ts.
 */
import { site } from '../config/site';
import { absoluteUrl, canonicalPath } from '../lib/urls';

export interface SeoProps {
  title: string;
  description?: string;
  /** Absolute URL or site path for the share image. */
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  /** Keep this page out of search engines (previews, drafts, utility pages). */
  noindex?: boolean;
  publishedTime?: Date;
  modifiedTime?: Date;
  jsonLd?: Record<string, unknown>[];
}

const {
  title,
  description = site.description,
  image = site.brand.socialImage.src,
  imageAlt = site.brand.socialImage.alt,
  type = 'website',
  noindex = false,
  publishedTime,
  modifiedTime,
  jsonLd = [],
} = Astro.props as SeoProps;

const fullTitle = title.includes(site.name) ? title : `${title} | ${site.name}`;
const canonical = absoluteUrl(canonicalPath(Astro.url.pathname));
const imageUrl = /^https?:\/\//.test(image) ? image : absoluteUrl(image);
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}

<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content="en_US" />
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:alt" content={imageAlt} />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />

{jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />)}
