---
/**
 * Full-bleed campaign feature: background photo, contrast overlay, headline,
 * description and exactly two actions (article + petition). All content comes
 * from src/config/campaign.ts via getFeaturedCampaign().
 */
import { Picture } from 'astro:assets';
import type { ResolvedCampaign } from '../lib/campaign';
import Icon from './Icon.astro';

interface Props {
  campaign: ResolvedCampaign;
  /** Heading level for the campaign title (h2 on the homepage). */
  headingLevel?: 'h2' | 'h3';
  /** Above the fold on this page: load the photo with high priority. */
  priority?: boolean;
}

const { campaign, headingLevel = 'h2', priority = false } = Astro.props;
const Heading = headingLevel;
const titleId = `campaign-${campaign.id}`;
---

<section
  class:list={['campaign', 'inverse', { 'campaign--preview': campaign.isPreview, 'campaign--no-photo': !campaign.imageMeta }]}
  aria-labelledby={titleId}
  style={`--focal: ${campaign.image.position}; --focal-mobile: ${campaign.image.positionMobile};`}
  data-campaign={campaign.id}
>
  <div class="campaign__media" aria-hidden={campaign.image.alt ? undefined : 'true'}>
    {
      campaign.imageMeta && (
        <Picture
          src={campaign.imageMeta}
          alt={campaign.image.alt}
          formats={['avif', 'webp']}
          widths={[640, 960, 1280, 1920, 2400].filter((w) => w <= campaign.imageMeta!.width)}
          sizes="100vw"
          class="campaign__img"
          loading={priority ? 'eager' : 'lazy'}
          fetchpriority={priority ? 'high' : 'auto'}
          decoding="async"
          layout="none"
        />
      )
    }
  </div>
  <div class="campaign__shade" aria-hidden="true"></div>

  <div class="container campaign__inner">
    {
      campaign.isPreview && (
        <p class="campaign__flag">
          <span class="tag">Preview</span>
        </p>
      )
    }
    <div class="campaign__content">
      <Heading id={titleId} class="campaign__title">{campaign.title}</Heading>
      <p class="campaign__desc">{campaign.description}</p>
      <div class="campaign__actions">
        <a class="btn btn--light btn--lg" href={campaign.articleHref}>
          Read the Article
          <Icon name="arrow-right" />
        </a>
        <a class="btn btn--action btn--lg campaign__sign" href={campaign.petitionHref}>
          Sign the Petition
        </a>
      </div>
      {campaign.isPreview && <p class="campaign__note">{campaign.previewNote}</p>}
      {campaign.image.credit && <p class="campaign__credit">Photo: {campaign.image.credit}</p>}
    </div>
  </div>
</section>

<style>
  .campaign {
    position: relative;
    isolation: isolate;
    display: grid;
    min-height: clamp(34rem, 30rem + 18vw, 47rem);
    overflow: hidden;
    background: var(--gv-deep-blue-800);
  }

  .campaign__media,
  .campaign__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .campaign__media :global(picture),
  .campaign__media :global(img) {
    width: 100%;
    height: 100%;
  }

  .campaign__media :global(img) {
    object-fit: cover;
    object-position: var(--focal-mobile);
  }

  /* Phones: photo shows at the top, text sits on a solid-to-clear gradient. */
  .campaign__shade {
    background: linear-gradient(
      to top,
      rgb(6 45 63 / 0.97) 0%,
      rgb(6 45 63 / 0.9) 45%,
      rgb(6 45 63 / 0.55) 75%,
      rgb(6 45 63 / 0.3) 100%
    );
  }

  .campaign__inner {
    position: relative;
    display: grid;
    align-content: end;
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 5rem);
  }

  .campaign__flag {
    position: absolute;
    top: clamp(1.25rem, 1rem + 1vw, 2rem);
    left: 0;
    margin: 0;
  }

  .campaign__flag .tag {
    background: rgb(6 45 63 / 0.7);
    color: var(--gv-white);
    border-color: rgb(255 255 255 / 0.8);
    font-size: 0.85rem;
  }

  .campaign__content {
    max-width: 40rem;
    /* Leaves the top of the photo visible on phones. */
    padding-top: clamp(9rem, 40vw, 14rem);
  }

  .campaign__title {
    font-size: clamp(2.1rem, 1.3rem + 2.9vw, 3.6rem);
    font-weight: var(--weight-display);
    line-height: 1.04;
    letter-spacing: -0.024em;
    color: var(--gv-white);
    text-wrap: balance;
  }

  .campaign__desc {
    max-width: 34rem;
    margin: var(--space-l) 0 0;
    font-family: var(--font-sans);
    font-size: var(--fs-lead);
    line-height: 1.42;
    color: var(--gv-white);
  }

  .campaign__actions {
    display: grid;
    gap: var(--space-s);
    margin-top: var(--space-xl);
  }

  .campaign__note {
    max-width: 34rem;
    margin: var(--space-l) 0 0;
    padding-left: var(--space-s);
    border-left: 3px solid var(--gv-slate-blue);
    font-size: var(--fs-small);
    color: var(--color-text-inverse-muted);
  }

  .campaign__credit {
    margin-top: var(--space-m);
    font-size: var(--fs-xs);
    color: var(--color-text-inverse-muted);
  }

  @media (min-width: 30em) {
    .campaign__actions {
      display: flex;
      flex-wrap: wrap;
    }
  }

  /* Wider screens: text on the left, photo visible on the right. */
  @media (min-width: 56em) {
    .campaign__media :global(img) {
      object-position: var(--focal);
    }

    .campaign__shade {
      background:
        linear-gradient(to right, rgb(6 45 63 / 0.94) 0%, rgb(6 45 63 / 0.82) 38%, rgb(6 45 63 / 0.35) 68%, rgb(6 45 63 / 0.12) 100%),
        linear-gradient(to top, rgb(6 45 63 / 0.5) 0%, rgb(6 45 63 / 0) 40%);
    }

    .campaign__inner {
      align-content: center;
    }

    .campaign__content {
      padding-top: 2rem;
    }
  }
</style>
