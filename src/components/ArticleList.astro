---
import type { Article } from '../lib/content';
import { ARTICLE_KIND_LABELS } from '../lib/content';
import { formatPlainDate, plainDateIso } from '../lib/dates';
import { links } from '../lib/urls';
import ContentImage from './ContentImage.astro';

interface Props {
  articles: Article[];
  /** 'compact' hides images (homepage sidebar); 'lead' enlarges the first item. */
  variant?: 'list' | 'compact' | 'lead';
  headingLevel?: 'h2' | 'h3';
}

const { articles, variant = 'list', headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
---

<ol class:list={['article-list', `article-list--${variant}`]} role="list">
  {
    articles.map((a, i) => (
      <li class:list={['article-item', { 'article-item--lead': variant === 'lead' && i === 0, 'article-item--has-image': a.data.image && variant !== 'compact' }]}>
        {a.data.image && variant !== 'compact' && (
          <div class="article-item__media frame">
            <ContentImage
              src={a.data.image.src}
              alt={a.data.image.alt}
              position={a.data.image.position}
              sizes={variant === 'lead' && i === 0 ? '(min-width: 64em) 60vw, 100vw' : '(min-width: 48em) 18rem, 100vw'}
            />
          </div>
        )}
        <div class="article-item__body">
          <Heading class="article-item__title">
            <a href={links.article(a.id)}>{a.data.title}</a>
          </Heading>
          <p class="meta">
            <span>{ARTICLE_KIND_LABELS[a.data.kind]}</span>
            <time datetime={plainDateIso(a.data.publishedAt)}>{formatPlainDate(a.data.publishedAt)}</time>
            {a.data.status !== 'published' && <span class="article-item__flag">{a.data.status === 'draft' ? 'Draft' : 'Preview'}</span>}
          </p>
          {variant !== 'compact' && <p class="article-item__excerpt">{a.data.excerpt}</p>}
        </div>
      </li>
    ))
  }
</ol>

<style>
  .article-list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .article-item {
    display: grid;
    gap: var(--space-m);
    padding-block: var(--space-l);
    border-top: 1px solid var(--color-border);
  }

  .article-item:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .article-item__media {
    aspect-ratio: 3 / 2;
  }

  .article-item__media :global(picture),
  .article-item__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .article-item__title {
    font-size: var(--fs-h3);
  }

  .article-item__title a {
    color: var(--color-heading);
    text-decoration: none;
  }

  .article-item__title a:hover {
    color: var(--color-link);
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }

  .article-item .meta {
    margin: var(--space-xs) 0 0;
  }

  .article-item__flag {
    font-weight: 700;
    color: var(--gv-crimson);
  }

  .article-item__excerpt {
    margin-top: var(--space-s);
    color: var(--color-text-muted);
    max-width: 62ch;
  }

  .article-list--compact .article-item__title {
    font-size: 1.2rem;
  }

  @media (min-width: 48em) {
    .article-item--has-image {
      grid-template-columns: 18rem 1fr;
      gap: var(--space-xl);
      align-items: start;
    }

    .article-item--lead {
      grid-template-columns: 1fr;
    }

    .article-item--lead .article-item__title {
      font-size: var(--fs-h2);
    }
  }

  @media (min-width: 64em) {
    .article-item--lead.article-item--has-image {
      grid-template-columns: 3fr 2fr;
      align-items: end;
    }
  }
</style>
