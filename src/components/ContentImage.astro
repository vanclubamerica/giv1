---
/**
 * Responsive, optimized image from src/assets/images/. Produces AVIF and
 * WebP at several widths; the browser downloads the smallest suitable one.
 */
import { Picture } from 'astro:assets';
import { resolveImage } from '../lib/images';

interface Props {
  src: string;
  alt: string;
  /** CSS object-position focal point. */
  position?: string;
  /** The `sizes` attribute: how wide the image is displayed. */
  sizes: string;
  widths?: number[];
  class?: string;
  /** Above-the-fold image: load immediately with high priority. */
  priority?: boolean;
}

const { src, alt, position, sizes, widths = [480, 768, 1080, 1440, 1920], class: className, priority = false } = Astro.props;
const image = resolveImage(src);
const usableWidths = widths.filter((w) => w <= image.width);
if (!usableWidths.length) usableWidths.push(image.width);
---

<Picture
  src={image}
  alt={alt}
  formats={['avif', 'webp']}
  widths={usableWidths}
  sizes={sizes}
  class={className}
  style={position ? `object-position: ${position}` : undefined}
  loading={priority ? 'eager' : 'lazy'}
  fetchpriority={priority ? 'high' : 'auto'}
  decoding="async"
  layout="none"
/>
