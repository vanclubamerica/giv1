# ---------------------------------------------------------------------------
# Get Involved Van — environment variables
#
# Copy this file to `.env` for local development. Never commit `.env`.
#
# FRONTEND (public) values are compiled into the static site and are visible
# to anyone. Only put values here that are SAFE TO PUBLISH.
#
# In production these are set as GitHub repository *variables* (not secrets):
#   Settings -> Secrets and variables -> Actions -> Variables
# ---------------------------------------------------------------------------

# Full URL of the deployed Supabase Edge Function that receives every form
# (petitions, volunteer sign-ups, contact messages, newsletter, RSVPs).
# Example: https://abcdefghijklmnop.supabase.co/functions/v1/submit
# Leave empty and the site will show a clear "online forms aren't connected
# yet" notice instead of a working form. It never fakes a submission.
PUBLIC_FORMS_ENDPOINT=

# Cloudflare Turnstile *site key* (public). Pairs with TURNSTILE_SECRET_KEY on
# the backend. Leave empty to rely on the honeypot, timing check and rate
# limiting only (not recommended for launch).
PUBLIC_TURNSTILE_SITE_KEY=


# ---------------------------------------------------------------------------
# BACKEND (secret) values — these are NOT used by the website build.
# Set them as Supabase Edge Function secrets, e.g.:
#   npx supabase secrets set --env-file supabase/.env.production
# Keep the real file out of Git (it is ignored by .gitignore).
# ---------------------------------------------------------------------------

# Provided automatically inside Supabase Edge Functions. Listed for reference.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Public site origin. Used to fetch /api/forms-manifest.json (which petitions
# and RSVPs are open) and to build confirmation/unsubscribe links.
SITE_URL=https://getinvolvedvan.com

# Comma-separated list of origins allowed to call the function (CORS).
ALLOWED_ORIGINS=https://getinvolvedvan.com,https://www.getinvolvedvan.com,http://localhost:4321

# Cloudflare Turnstile secret key (server-side verification of the widget).
TURNSTILE_SECRET_KEY=

# Long random string used to hash IP addresses for rate limiting.
# Generate one with:  node -e "console.log(crypto.randomBytes(32).toString('hex'))"
RATE_LIMIT_SALT=

# Resend (https://resend.com) API key for transactional email: newsletter
# confirmation links and organizer notifications. Newsletter sign-up is
# refused (with an honest error) until this and EMAIL_FROM are set.
RESEND_API_KEY=

# Sender address on a domain verified in Resend.
# Example: Get Involved Van <updates@getinvolvedvan.com>
EMAIL_FROM=

# Where to send "new contact message / new volunteer" notifications.
# Optional — submissions are always stored in the database regardless.
ORGANIZER_EMAIL=
